<svg xmlns="http://www.w3.org/2000/svg" width="400" height="300" viewBox="0 0 400 300">
    <defs>
      <linearGradient id="grad-A02" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#f1f5f9"/>
        <stop offset="100%" stop-color="#ffffff"/>
      </linearGradient>
    </defs>
    <rect width="400" height="300" fill="url(#grad-A02)"/>
    <rect x="20" y="20" width="360" height="260" rx="16" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" opacity="0.9"/>
    
    <!-- Badge de ID -->
    <rect x="35" y="35" width="48" height="24" rx="6" fill="#1e3a8a"/>
    <text x="59" y="51" font-family="'Segoe UI', Arial, sans-serif" font-size="12" font-weight="bold" fill="#ffffff" text-anchor="middle">A02</text>
    
    <!-- Emoji o Icono central representativo -->
    <text x="200" y="145" font-family="'Segoe UI Emoji', 'Apple Color Emoji', Arial" font-size="75" text-anchor="middle">📄</text>
    
    <!-- Nombre y detalle exacto del producto -->
